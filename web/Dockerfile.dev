# Folyo web — geliştirme imajı (Vite dev server, HMR)
# docker-compose.yml içindeki `web` servisi bu imajı kullanır; kaynak kod
# bind-mount edilir, bağımlılıklar (node_modules) yalnızca imaj katmanındadır.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev"]
