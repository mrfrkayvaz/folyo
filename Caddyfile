# Folyo — Caddy ters proxy (canlı geliştirme)
# Statik build yok: / → Vite dev server (web:5173), /api → FastAPI (web-api:8000).
# docker-compose içindeki "caddy" servisi bu dosyayı mount eder.
# http://localhost:8080 → aynı arayüz; doğrudan http://localhost:5173 da çalışır.

:80 {
	# 1) Backend: /api/* → FastAPI (compose servis adı: web-api)
	handle /api/* {
		reverse_proxy web-api:8000
	}

	# 2) Frontend: SPA → Vite dev server (HMR websocket dahil, otomatik)
	handle {
		reverse_proxy web:5173
	}

	encode gzip
}
