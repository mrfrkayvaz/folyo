# --- uv tabanlı ARQ worker image (production / Coolify) ---
# web-api/Dockerfile ile aynı kurulum; fark: varsayılan komut ARQ worker'ı başlatır.
# Coolify'da web-worker uygulaması: Build Pack=Dockerfile, Base Directory=web-api,
# Dockerfile Location=Dockerfile.worker (field yoksa Start Command override gerekmez —
# imajın CMD'si zaten worker). Domain/port YOK (worker HTTP dinlemez).
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app

# OCR sistem bağımlılıkları (embed/enrich sırasında taranmış sayfa fallback'i için)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        tesseract-ocr tesseract-ocr-tur tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

# Bağımlılıkları lockfile'dan kur (kaynak kopyalamadan önce — katman önbelleği için)
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# Uygulama kodunu kopyala
COPY . .

ENV PYTHONUNBUFFERED=1

# Kalıcı veri (Coolify'da volume bağla): Chroma vektör DB + yüklenen belgeler.
# web-api ile AYNI volume'lar kullanılmalı (aynı Chroma dosyasına yazar).
VOLUME /app/chroma_data /app/storage

# ARQ worker: görevleri (embed/enrich/workspace_summary) Redis kuyruğundan tüketir.
CMD ["uv", "run", "--no-sync", "arq", "app.worker_settings.settings"]