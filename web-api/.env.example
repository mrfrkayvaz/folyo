# Contextus — web-api ortam ayarları (OpenRouter örneği)
# cp web-api/.env.example web-api/.env  → sonra LLM_API_KEY doldur

# ── LLM (soru-cevap): Nemotron 3 Ultra (free) ─────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free

# ── Embedding: Nemotron 3 Embed 1B (free) ────────────────────────────────────
# OpenRouter'da aynı sağlayıcı → boş bırak (LLM_*'den düşer).
# DİKKAT: bu embed model yalnızca ":free" sonekiyle /embeddings çalışır.
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=nvidia/nemotron-3-embed-1b:free