# Folyo — web-api ortam ayarları (OpenRouter örneği)
# cp web-api/.env.example web-api/.env  → sonra LLM_API_KEY doldur

# ── LLM (soru-cevap): DeepSeek V4 Flash ───────────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash

# ── Embedding: OpenAI Text Embedding 3 Small ──────────────────────────────────
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=openai/text-embedding-3-small
# ── Görsel işleme (ikinci sağlayıcı) — OpenAI-uyumlu Vision LLM ────────────────
# OCR yetersiz kaldığında kullanılır. Boşsa anahtar/adres LLM_* değerlerine düşer.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
