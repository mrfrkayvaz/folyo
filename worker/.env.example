# worker özel ortam şablonu — değerleri .env'e doldur (web-api/panel-api'den bağımsız).
# Worker, web-api'nin kodunu import etmez; yalnızca aynı sağlayıcı anahtarlarını kullanır.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=

VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

DATABASE_URL=postgresql+asyncpg://folyo:folyo@localhost:5432/folyo
CHROMA_DIR=chroma_data

# Container'da compose environment'ı (redis://redis:6379/0) bu değeri ezer; yerel çalıştırma içindir.
REDIS_URL=redis://localhost:6379/0